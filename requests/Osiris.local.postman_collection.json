        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "{ const link = pm.response.json()._links.createSession; pm.expect(link.method).to.equal('POST'); pm.expect(link.href).to.match(/^\\/(?!\\/)/); pm.variables.set('createSession',link.href); }",
              "{ const link = pm.response.json()._links.delete; pm.expect(link.method).to.equal('DELETE'); pm.expect(link.href).to.match(/^\\/(?!\\/)/); pm.variables.set('deleteProject',link.href); }"
            ]
          }
        }
      ]
    },
    {
