{
  "info": {
    "name": "Osiris Build 2 AI Harness",
    "description": "Build 1 reads and Build 2 collection/CRUD operations. Writes modify your local database; use isolated test fixtures for demonstrations.\nRecommended release evidence: run the isolated named CRUD lifecycle in order on a development fixture; never point destructive requests at production. The published Git/LEA submission record must be confirmed separately.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "emptyBaseUrl",
      "value": "http://127.0.0.1:8081"
    },
    {
      "key": "demoProjectId",
      "value": "prj_demo_build2"
    },
    {
      "key": "demoSessionId",
      "value": "ses_demo_build2"
    },
    {
      "key": "demoMessageId",
      "value": "msg_demo_build2"
    },
    {
      "key": "demoTaskId",
      "value": "tsk_demo_build2"
    }
  ],
  "item": [
    {
      "name": "List sessions",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/sessions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Canonical seed sessions are present', () => {",
              "  const sessions = pm.response.json();",
              "  pm.expect(sessions).to.be.an('array');",
              "  pm.expect(sessions.map(s => s.id)).to.include.members(['ses_101', 'ses_102', 'ses_103', 'ses_201', 'ses_202']);",
              "  pm.expect(sessions.find(s => s.id === 'ses_101').title).to.eql('Investigate crash');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get session",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/sessions/ses_101"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Seeded ID and title', () => {",
              "  const session = pm.response.json();",
              "  pm.expect(session.id).to.eql('ses_101');",
              "  pm.expect(session.title).to.eql('Investigate crash');",
              "});"
            ]
          }
        }
      ]
    },
