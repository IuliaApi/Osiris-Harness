{
  "info": {
    "name": "Osiris Workspace · local owner workflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the complete collection in order on a disposable loopback database with an owner account. Define username and password as local, sensitive environment variables; enable the Postman cookie jar. No credentials ship with this collection. Created resource links and CSRF token are local run variables only. A partial run may leave the newly created project behind. No provider dispatch is performed."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.variables.get('baseUrl');",
          "if (!/^http:\\/\\/(127\\.0\\.0\\.1|localhost)(:\\d{1,5})?$/.test(base)) { throw Error('Refusing a non-loopback base URL'); }",
          "if (pm.request.method !== 'GET' && pm.info.requestName !== 'Sign in' && pm.info.requestName !== 'Reject missing CSRF') pm.request.headers.upsert({key:'X-CSRF-Token',value:pm.variables.get('csrf')});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Sign in",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{loginBody}}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const u = pm.environment.get('username'), p = pm.environment.get('password'); if (!u || !p) throw Error('Set a local username and password'); pm.variables.set('loginBody',JSON.stringify({username:u,password:p}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.variables.set('csrf',pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read identity",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/me",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Identity comes from cookie',()=>pm.expect(pm.response.json().user.username).to.equal(pm.environment.get('username')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Discover authorized links",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "{ const link = pm.response.json()._links.createProject; pm.expect(link.method).to.equal('POST'); pm.expect(link.href).to.match(/^\\/(?!\\/)/); pm.variables.set('createProject',link.href); }",
              "{ const link = pm.response.json()._links.runtime; pm.expect(link.method).to.equal('GET'); pm.expect(link.href).to.match(/^\\/(?!\\/)/); pm.variables.set('runtime',link.href); }",
              "{ const link = pm.response.json()._links.logout; pm.expect(link.method).to.equal('POST'); pm.expect(link.href).to.match(/^\\/(?!\\/)/); pm.variables.set('logout',link.href); }",
              "{ const link = pm.response.json()._links.budget; pm.expect(link.method).to.equal('GET'); pm.expect(link.href).to.match(/^\\/(?!\\/)/); pm.variables.set('budget',link.href); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Legacy session array",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/sessions",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Legacy plain array',()=>pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Bounded session page",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/sessions?limit=1&sort=title&order=asc",
