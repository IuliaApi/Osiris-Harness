          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "{ const link = pm.response.json()._links.self; pm.expect(link.method).to.equal('GET'); pm.expect(link.href).to.match(/^\\/(?!\\/)/); pm.variables.set('session',link.href); }",
              "{ const link = pm.response.json()._links.update; pm.expect(link.method).to.equal('PATCH'); pm.expect(link.href).to.match(/^\\/(?!\\/)/); pm.variables.set('updateSession',link.href); }",
              "{ const link = pm.response.json()._links.createMessage; pm.expect(link.method).to.equal('POST'); pm.expect(link.href).to.match(/^\\/(?!\\/)/); pm.variables.set('createMessage',link.href); }",
              "{ const link = pm.response.json()._links.createTask; pm.expect(link.method).to.equal('POST'); pm.expect(link.href).to.match(/^\\/(?!\\/)/); pm.variables.set('createTask',link.href); }",
              "{ const link = pm.response.json()._links.requestTool; pm.expect(link.method).to.equal('POST'); pm.expect(link.href).to.match(/^\\/(?!\\/)/); pm.variables.set('requestTool',link.href); }",
              "{ const link = pm.response.json()._links.context; pm.expect(link.method).to.equal('GET'); pm.expect(link.href).to.match(/^\\/(?!\\/)/); pm.variables.set('context',link.href); }",
              "{ const link = pm.response.json()._links.delete; pm.expect(link.method).to.equal('DELETE'); pm.expect(link.href).to.match(/^\\/(?!\\/)/); pm.variables.set('deleteSession',link.href); }"
            ]
