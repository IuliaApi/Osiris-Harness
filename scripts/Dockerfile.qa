ARG APP_IMAGE=php:8.4-cli-alpine
FROM ${APP_IMAGE} AS unit
USER root
RUN apk add --no-cache python3 py3-yaml
USER www-data
COPY test-*.php representation-fixture.php scripts/
COPY test-semantic-formats.py test-ollama-transport.py test-http-no-db.py scripts/

FROM python:3.12-slim-bookworm AS http
WORKDIR /repo
COPY contract-requirements.txt /tmp/contract-requirements.txt
RUN pip install --no-cache-dir -r /tmp/contract-requirements.txt 'psycopg[binary]==3.2.9'
ENV PYTHONDONTWRITEBYTECODE=1

FROM http AS browser
RUN pip install --no-cache-dir playwright==1.55.0 \
    && python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*
