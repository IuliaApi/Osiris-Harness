# Copy to .env in the project root. Docker Compose reads it automatically.
# Keep .env private; NEVER commit API keys. Restart .\run.ps1 after updates.
OSIRIS_DATABASE_NAME=osiris_dev
OSIRIS_PORT=8080
OSIRIS_GITHUB_MODE=online

# Choose a provider in Osiris Settings (stored in your browser only).
# To use OpenAI or Anthropic, supply your own API key below.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OSIRIS_OPENAI_MODEL=gpt-4.1-mini
OSIRIS_ANTHROPIC_MODEL=claude-haiku-5-5

# To use local Ollama, install Ollama on your Windows host, run `ollama pull llama3.2`
# and ensure http://localhost:11434 is reachable from Docker Desktop.
# No API key is needed. 1 allows connecting; it does NOT verify the host is running.
OSIRIS_OLLAMA_ENABLED=1
OSIRIS_OLLAMA_MODEL=llama3.2
